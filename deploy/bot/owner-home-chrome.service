[Unit]
Description=The bot's second Chrome (CDP 127.0.0.1:9223): every page through the owner's home connection, for sites that block the server (Zomato)
After=hermes-dcv-session.service owner-homeproxy.service
Wants=hermes-dcv-session.service owner-homeproxy.service

[Service]
User=hermes
Group=hermes
Environment=HOME=/home/hermes DISPLAY=:0 XAUTHORITY=/run/user/1001/dcv/hermes-desktop.xauth
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1001/bus XDG_RUNTIME_DIR=/run/user/1001 XDG_SESSION_TYPE=x11
WorkingDirectory=/home/hermes
ExecStart=/usr/bin/google-chrome-stable --no-first-run --no-default-browser-check --disable-session-crashed-bubble \
  --hide-crash-restore-bubble --no-crash-upload --restore-last-session=false --window-size=1920,1080 \
  --remote-debugging-port=9223 --remote-debugging-address=127.0.0.1 --user-data-dir=/home/hermes/.config/home-chrome \
  --password-store=basic --proxy-server=http://127.0.0.1:8773 about:blank
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
