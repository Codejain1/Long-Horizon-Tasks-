# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml.
POSTGRES_PASSWORD=change-me
# Signs the state carried through MCP approval round trips. Any long random string; keep it stable.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HORIZON_STATE_SECRET=change-me
# Optional: score decisions with Jev (TypeSafe) or the small-LLM comparison scorer (Claude).
HORIZON_SCORER=none
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=
# Optional: an unmetered key for local testing of /mcp. Leave empty in production.
HORIZON_DEV_API_KEY=
# Behind a TLS-terminating proxy, set to "*" (or the proxy's IP) so session cookies are marked Secure.
FORWARDED_ALLOW_IPS=127.0.0.1
HORIZON_PORT=8000
